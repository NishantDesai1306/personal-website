---
import { profile, skillGroups } from '../data/profile';
---

<section class="section" id="about-me" tabindex="-1" aria-labelledby="about-title">
  <div class="wrap grid">
    <div>
      <p class="eyebrow">// elements · about me</p>
      <h2 class="section-title" id="about-title">About me</h2>
      <div class="prose">
        {profile.about.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
    <aside class="computed panel" aria-labelledby="skills-title">
      <h3 class="computed-head mono" id="skills-title">Computed · skills</h3>
      <dl class="skills">
        {
          skillGroups.map(({ name, items }) => (
            <div>
              <dt class="mono">{name}</dt>
              <dd class="chips">
                {items.map((item) => (
                  <span class="chip">{item}</span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </aside>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 56px;
    align-items: start;
  }
  .prose {
    margin-top: 28px;
    max-width: 62ch;
  }
  .prose p {
    font-size: 18px;
    color: var(--text-2);
    margin-bottom: 18px;
  }
  .prose p:first-child {
    color: var(--text);
    font-size: 21px;
    line-height: 1.5;
  }
  .computed {
    overflow: hidden;
  }
  .computed-head {
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
  }
  .skills > div {
    padding: 14px 16px;
  }
  .skills > div + div {
    border-top: 1px solid var(--line);
  }
  .skills dt {
    font-size: 12.5px;
    color: var(--attr);
    margin-bottom: 8px;
  }
  .skills dd {
    margin: 0;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
