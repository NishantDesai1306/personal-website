---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Vitals from '../components/Vitals.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
import UpdateToast from '../components/UpdateToast.astro';
import { profile } from '../data/profile';
---

<Base
  title={`${profile.tagline} | ${profile.name}`}
  description={`Senior frontend engineer in Canada with ${profile.yearsOfExperience} years of experience in React, Next.js and Material UI, co-leading framework migrations and improving web performance and Core Web Vitals.`}
>
  <TopBar />
  <main id="main-content" tabindex="-1">
    <Hero />
    <About />
    <CaseStudies />
    <Vitals />
    <Experience />
    <Projects />
    <Contact />
  </main>
  <footer class="footer wrap mono">
    <span>© {new Date().getFullYear()} {profile.name}</span>
    <span>
      <a href="https://github.com/NishantDesai1306/personal-website" rel="noopener noreferrer">view source</a>
      ·
      <a href="/llms.txt">llms.txt</a>
    </span>
  </footer>
  <UpdateToast />
</Base>

<script>
  // The page's single client entry for cursor effects, so they bundle (and inline) as one script.
  import { initEffectsToggle } from '../scripts/effects';
  import { initCursorField } from '../scripts/cursor-field';
  import { initHeroTilt } from '../scripts/hero-tilt';
  import { initInspectOverlay } from '../scripts/inspect-overlay';
  import { initMagnetic } from '../scripts/magnetic';
  import { initLayoutDebug } from '../scripts/layout-debug';

  initEffectsToggle();
  initCursorField();
  initHeroTilt();
  initInspectOverlay();
  initMagnetic();
  initLayoutDebug();
</script>

<style>
  main:focus {
    outline: none;
  }
  .footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 28px;
    padding-bottom: 48px;
    border-top: 1px solid var(--line);
    font-size: 12px;
    color: var(--muted);
  }
  .footer a {
    color: var(--text-2);
  }
</style>
