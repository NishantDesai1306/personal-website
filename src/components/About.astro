---
import { profile, technologies } from '../data/profile';
---

<section class="section" id="about-me" tabindex="-1" aria-labelledby="about-title">
  <div class="wrap grid">
    <div>
      <p class="eyebrow">// elements · about me</p>
      <h2 class="section-title" id="about-title">About me</h2>
      <div class="prose">
        {profile.about.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
    <aside class="computed panel" aria-labelledby="tech-title">
      <h3 class="computed-head mono" id="tech-title">Computed · technologies</h3>
      <p class="computed-note">Technologies that I have worked with to build awesome applications</p>
      <ul class="tech">
        {
          technologies.map(({ label, href }) => (
            <li>
              <a href={href} rel="noopener noreferrer">
                <span class="prop">{label}</span>
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 56px;
    align-items: start;
  }
  .prose {
    margin-top: 28px;
    max-width: 62ch;
  }
  .prose p {
    font-size: 18px;
    color: var(--text-2);
    margin-bottom: 18px;
  }
  .prose p:first-child {
    color: var(--text);
    font-size: 21px;
    line-height: 1.5;
  }
  .computed {
    overflow: hidden;
  }
  .computed-head {
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
  }
  .computed-note {
    font-size: 14px;
    color: var(--muted);
    padding: 14px 16px 6px;
  }
  .tech li + li {
    border-top: 1px solid var(--line);
  }
  .tech a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    font: 400 14px var(--mono);
    text-decoration: none;
    color: var(--text-2);
  }
  .tech a:hover {
    background: var(--panel-2);
    color: var(--text);
  }
  .tech .prop::before {
    content: '▸ ';
    color: var(--attr);
  }
  .arrow {
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
