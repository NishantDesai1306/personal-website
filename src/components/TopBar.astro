---
import { profile } from '../data/profile';

const sections = [
  { href: '#about-me', label: 'Elements' },
  { href: '#vitals', label: 'Lighthouse' },
  { href: '#experience', label: 'Performance' },
  { href: '#projects', label: 'Network' },
  { href: '#contact-me', label: 'Console' },
];
---

<header class="bar">
  <div class="bar-in wrap">
    <a class="brand" href="#top" aria-label={`${profile.name} — back to top`}>
      <span class="dot" aria-hidden="true"></span>nishant.desai
    </a>
    <nav class="tabs" aria-label="Sections">
      {sections.map(({ href, label }) => <a href={href} data-nav-link>{label}</a>)}
    </nav>
    <div class="bar-actions">
      <button class="fx" type="button" data-effects-toggle aria-pressed="true" aria-label="Cursor effects" title="Turn cursor effects off">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <path d="M3 2l9 5-4 1-1 4z" fill="currentColor" />
          <path class="sparkle" d="M12.5 10.5v3M11 12h3M13.5 2v2M12.5 3h2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
          <path class="slash" d="M2 14L14 2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
        </svg>
      </button>
      <button class="install" type="button" data-install hidden>install app</button>
      <a class="resume" href={profile.resume}>resume.pdf <span aria-hidden="true">↓</span></a>
    </div>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(14 15 17 / 0.9);
    backdrop-filter: saturate(1.4) blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar-in {
    display: flex;
    align-items: stretch;
    min-height: var(--bar-h);
    font: 500 13px var(--mono);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-right: 20px;
    margin-right: 4px;
    border-right: 1px solid var(--line);
    text-decoration: none;
    white-space: nowrap;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--good);
    box-shadow: 0 0 0 4px rgb(62 207 142 / 0.15);
  }
  .tabs {
    display: flex;
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .tabs a {
    display: flex;
    align-items: center;
    padding: 0 14px;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }
  .tabs a:hover {
    color: var(--text);
  }
  .tabs a[aria-current='true'] {
    color: var(--text);
    border-bottom-color: var(--amber);
  }
  .bar-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-left: 12px;
  }
  .resume,
  .install {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--amber);
    text-decoration: none;
    white-space: nowrap;
    background: none;
    border: 0;
    cursor: pointer;
    min-height: 44px;
  }
  .resume:hover,
  .install:hover {
    text-decoration: underline;
  }
  /* Only offered where the effects can actually run (mouse, motion allowed, JS). */
  .fx {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    min-height: 36px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: none;
    color: var(--amber);
    cursor: pointer;
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    :global(.js) .fx {
      display: inline-flex;
    }
  }
  .fx:hover {
    border-color: var(--amber);
  }
  .fx[aria-pressed='true'] .slash,
  .fx[aria-pressed='false'] .sparkle {
    display: none;
  }
  .fx[aria-pressed='false'] {
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .brand {
      display: none;
    }
    .tabs a {
      padding: 0 11px;
    }
  }
  @media (max-width: 520px) {
    .resume {
      display: none;
    }
    .bar-actions {
      display: contents;
    }
    .install {
      margin-left: 12px;
    }
  }
</style>

<script>
  // The cursor-effects switch ([data-effects-toggle]) is wired by src/scripts/effects.ts.

  // Highlight the tab for the section currently in view.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const sections = links
    .map((link) => document.querySelector<HTMLElement>(link.hash))
    .filter((section): section is HTMLElement => section !== null);

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const link of links) {
          if (link.hash === `#${entry.target.id}`) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        }
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  sections.forEach((section) => observer.observe(section));

  // Move keyboard focus with in-page navigation, not just the scroll position.
  links.forEach((link) =>
    link.addEventListener('click', () => {
      const target = document.querySelector<HTMLElement>(link.hash);
      requestAnimationFrame(() => target?.focus({ preventScroll: true }));
    }),
  );
  // Native tabbing may reveal only part of a link in a horizontal scroller.
  links.forEach((link) =>
    link.addEventListener('focus', () => {
      link.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'instant' });
    }),
  );
</script>
