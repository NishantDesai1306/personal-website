---
import { projects } from '../data/profile';
---

<section class="section" id="projects" tabindex="-1" aria-labelledby="projects-title">
  <div class="wrap">
    <p class="eyebrow">// network · personal projects</p>
    <h2 class="section-title" id="projects-title">Projects</h2>

    <div class="table panel">
      <div class="thead mono" aria-hidden="true">
        <span>Name</span><span>Type</span><span>Stack</span><span>Links</span>
      </div>
      <ul>
      {
        projects.map((project) => (
          <li class="row" id={`project-${project.id}`}>
            <div class="name">
              <h3 id={`project-title-${project.id}`}>{project.name}</h3>
              <p>{project.summary}</p>
              {project.parts && (
                <details>
                  <summary class="mono">{project.parts.length} implementations</summary>
                  <ul class="parts">
                    {project.parts.map((part) => (
                      <li>
                        <h4>{part.name}</h4>
                        <p>{part.description}</p>
                        <div class="chips">
                          {part.stack.map((tech) => (
                            <span class="chip">{tech}</span>
                          ))}
                        </div>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </div>
            <p class="kind mono">
              <span class="label">Type</span>
              {project.kind}
            </p>
            <div class="stack">
              <span class="label mono">Stack</span>
              <div class="chips">
                {project.stack.map((tech) => (
                  <span class="chip">{tech}</span>
                ))}
              </div>
            </div>
            <ul class="links">
              {project.links.map((link) => (
                <li>
                  <a class="btn" href={link.href} rel="noopener noreferrer" aria-label={`${project.name} ${link.label.toLowerCase()}`}>
                    {link.label.toLowerCase()} <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
      </ul>
    </div>
  </div>
</section>

<style>
  .table {
    margin-top: 48px;
    overflow: hidden;
  }
  .thead,
  .row {
    display: grid;
    grid-template-columns: minmax(0, 2.4fr) minmax(0, 0.9fr) minmax(0, 1.3fr) auto;
    gap: 24px;
    padding: 0 20px;
  }
  .thead {
    font-size: 12px;
    color: var(--muted);
    padding-top: 10px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
    background: var(--panel-2);
  }
  .row {
    padding-top: 22px;
    padding-bottom: 22px;
    align-items: start;
    transition: background 0.15s;
  }
  .row + .row {
    border-top: 1px solid var(--line);
  }
  .row:hover {
    background: rgb(255 255 255 / 0.015);
  }
  .name h3 {
    font: 600 19px/1.3 var(--sans);
    letter-spacing: -0.01em;
  }
  .name > p {
    margin-top: 6px;
    color: var(--text-2);
    font-size: 15px;
    max-width: 60ch;
  }
  details {
    margin-top: 12px;
  }
  summary {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    cursor: pointer;
    font-size: 13px;
    color: var(--amber);
  }
  .parts {
    margin-top: 6px;
    border-left: 1px solid var(--line);
    padding-left: 16px;
  }
  .parts li + li {
    margin-top: 18px;
  }
  .parts h4 {
    font: 500 14px var(--mono);
    color: var(--attr);
  }
  .parts p {
    margin: 4px 0 8px;
    color: var(--text-2);
    font-size: 14.5px;
  }
  .kind {
    font-size: 13px;
    color: var(--text-2);
    padding-top: 3px;
  }
  .label {
    display: none;
  }
  .links {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .links .btn {
    min-height: 40px;
    width: 100%;
    justify-content: space-between;
  }
  @media (max-width: 900px) {
    .thead {
      display: none;
    }
    .row {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .label {
      display: block;
      font-size: 11px;
      color: var(--muted);
      margin-bottom: 6px;
    }
    .links {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .links .btn {
      width: auto;
      gap: 10px;
    }
  }
</style>
