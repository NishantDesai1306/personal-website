---
import { profile } from '../data/profile';

const sections = [
  { href: '#about-me', label: 'Elements' },
  { href: '#vitals', label: 'Lighthouse' },
  { href: '#experience', label: 'Performance' },
  { href: '#projects', label: 'Network' },
  { href: '#contact-me', label: 'Console' },
];
---

<header class="bar">
  <div class="bar-in wrap">
    <a class="brand" href="#top" aria-label={`${profile.name} — back to top`}>
      <span class="dot" aria-hidden="true"></span>nishant.desai
    </a>
    <nav class="tabs" aria-label="Sections">
      {sections.map(({ href, label }) => <a href={href} data-nav-link>{label}</a>)}
    </nav>
    <div class="bar-actions">
      <button class="install" type="button" data-install hidden>install app</button>
      <a class="resume" href={profile.resume}>resume.pdf <span aria-hidden="true">↓</span></a>
    </div>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(14 15 17 / 0.9);
    backdrop-filter: saturate(1.4) blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar-in {
    display: flex;
    align-items: stretch;
    min-height: var(--bar-h);
    font: 500 13px var(--mono);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-right: 20px;
    margin-right: 4px;
    border-right: 1px solid var(--line);
    text-decoration: none;
    white-space: nowrap;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--good);
    box-shadow: 0 0 0 4px rgb(62 207 142 / 0.15);
  }
  .tabs {
    display: flex;
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tabs a {
    display: flex;
    align-items: center;
    padding: 0 14px;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }
  .tabs a:hover {
    color: var(--text);
  }
  .tabs a[aria-current='true'] {
    color: var(--text);
    border-bottom-color: var(--amber);
  }
  .bar-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-left: 12px;
  }
  .resume,
  .install {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--amber);
    text-decoration: none;
    white-space: nowrap;
    background: none;
    border: 0;
    cursor: pointer;
    min-height: 44px;
  }
  .resume:hover,
  .install:hover {
    text-decoration: underline;
  }
  @media (max-width: 760px) {
    .brand {
      display: none;
    }
    .tabs a {
      padding: 0 11px;
    }
    /* Hint that more tabs are reachable by scrolling. */
    .tabs {
      mask-image: linear-gradient(90deg, #000 80%, transparent);
    }
  }
  @media (max-width: 520px) {
    .bar-actions {
      display: none;
    }
  }
</style>

<script>
  // Highlight the tab for the section currently in view.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const sections = links
    .map((link) => document.querySelector<HTMLElement>(link.hash))
    .filter((section): section is HTMLElement => section !== null);

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const link of links) {
          if (link.hash === `#${entry.target.id}`) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        }
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  sections.forEach((section) => observer.observe(section));

  // Move keyboard focus with in-page navigation, not just the scroll position.
  links.forEach((link) =>
    link.addEventListener('click', () => {
      const target = document.querySelector<HTMLElement>(link.hash);
      requestAnimationFrame(() => target?.focus({ preventScroll: true }));
    }),
  );
</script>
