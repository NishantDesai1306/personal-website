---
import { caseStudies } from '../data/profile';
---

<section class="section" id="case-studies" tabindex="-1" aria-labelledby="case-studies-title">
  <div class="wrap">
    <p class="eyebrow">// sources · engineering case study</p>
    <h2 class="section-title" id="case-studies-title">Case study</h2>

    {
      caseStudies.map((study) => (
        <article class="study panel" id={`case-${study.id}`} aria-labelledby={`case-title-${study.id}`}>
          <header class="head">
            <p class="file mono" aria-hidden="true">{study.id}.md</p>
            <h3 id={`case-title-${study.id}`}>{study.title}</h3>
            <p class="meta mono">{study.company}</p>
            <p class="summary">{study.summary}</p>
          </header>

          <figure class="chain">
            <figcaption class="mono">Dependency chain</figcaption>
            <ol class="mono">
              {study.chain.map((step) => (
                <li>{step}</li>
              ))}
            </ol>
          </figure>

          <dl class="steps">
            {study.sections.map(({ heading, body }) => (
              <div>
                <dt class="mono">{heading}</dt>
                <dd>{body}</dd>
              </div>
            ))}
          </dl>

          <div class="chips">
            {study.stack.map((tech) => (
              <span class="chip">{tech}</span>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .study {
    margin-top: 48px;
    padding: 28px;
  }
  .file {
    font-size: 12px;
    color: var(--muted);
  }
  h3 {
    margin-top: 10px;
    font: 600 clamp(22px, 2.6vw, 28px)/1.25 var(--sans);
    letter-spacing: -0.01em;
  }
  .meta {
    margin-top: 4px;
    font-size: 13px;
    color: var(--amber);
  }
  .summary {
    margin-top: 14px;
    max-width: 68ch;
    font-size: 18px;
    color: var(--text);
  }
  .chain {
    margin: 28px 0 0;
  }
  .chain figcaption {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .chain ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 0;
    list-style: none;
    padding: 0;
    font-size: 13px;
  }
  .chain li {
    position: relative;
    padding: 6px 10px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--panel-2);
    color: var(--text-2);
  }
  .chain li:last-child {
    border-color: var(--amber);
    color: var(--text);
  }
  .chain li + li::before {
    content: '→';
    position: absolute;
    left: -22px;
    color: var(--muted);
  }
  .chain li + li {
    margin-left: 32px;
  }
  .steps {
    margin-top: 28px;
    border-top: 1px solid var(--line);
  }
  .steps > div {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .steps dt {
    font-size: 13px;
    color: var(--attr);
    padding-top: 2px;
  }
  .steps dd {
    margin: 0;
    max-width: 70ch;
    color: var(--text-2);
  }
  .chips {
    margin-top: 20px;
  }
  @media (max-width: 700px) {
    .study {
      padding: 20px;
    }
    .steps > div {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
